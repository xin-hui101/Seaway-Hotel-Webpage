{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seaway-hotel-webpage",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Run the Worker (password check) before serving ANY file, including index.html.
    "run_worker_first": true
  }
}
